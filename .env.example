DEMO_MODE=true
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
DATABASE_URL=sqlite:///./claimproof.db
# Optional comma-separated approved public HTTPS hosts; empty disables live retrieval.
# Add api.github.com to allow live repository metadata in the consistency scan.
EVIDENCE_ALLOWED_HOSTS=
# Optional token for higher GitHub API rate limits during live scans. Never commit a value.
GITHUB_TOKEN=
# Optional Tavily search: public context for opening questions, stored as labeled evidence.
# Empty disables it outside DEMO_MODE (DEMO_MODE uses a labeled synthetic snippet).
TAVILY_API_KEY=
# Optional Solari cloud browser for the "solari" evidence mode. Same EVIDENCE_ALLOWED_HOSTS allowlist applies.
SOLARI_API_KEY=
SOLARI_BASE_URL=https://api.getsolari.com
# Claims one interview may cover (1-5). The demo uses 3 to fit fifteen minutes.
MAX_INTERVIEW_CLAIMS=3
# Optional Block Convey PRISM mirror. Empty key or project id keeps traces local-only.
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=
